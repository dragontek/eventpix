# EventPix environment variables
# Copy to `.env` and fill in values. Scripts in `scripts/` load this via `dotenv` / shell env.

# --- Server-side scripts (schema setup, data migration, deploy) ---
# Endpoint is your self-hosted Appwrite instance (no trailing slash).
APPWRITE_ENDPOINT=https://dragontek.io/v1
APPWRITE_PROJECT_ID=
# Server API key with full access (created in the Appwrite Console).
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=eventpix
APPWRITE_BUCKET_ID=photos
APPWRITE_AVATARS_BUCKET_ID=avatars
APPWRITE_USERS_COLLECTION_ID=users
APPWRITE_EVENTS_COLLECTION_ID=events
APPWRITE_PHOTOS_COLLECTION_ID=photos
APPWRITE_INVITATIONS_COLLECTION_ID=invitations

# --- Frontend (web: apps/web/.env.local) ---
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://dragontek.io/v1
# NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# --- Frontend (admin: apps/admin/.env) ---
# VITE_APPWRITE_ENDPOINT=https://dragontek.io/v1
# VITE_APPWRITE_PROJECT_ID=

# Google OAuth (for the Appwrite Google OAuth provider)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
